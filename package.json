{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "Parallax Flow backend services",
  "scripts": {
    "postinstall": "prisma generate",
    "assets:pdf": "node scripts/build-protected-pdf-assets.mjs",
    "predev": "npm run assets:pdf",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "prisma generate && npm run assets:pdf && tsc -p tsconfig.build.json",
    "jobs:notifications": "tsx src/jobs/run-notification-dispatch.ts",
    "jobs:run-once:dev": "tsx src/jobs/run-durable-jobs.ts",
    "jobs:worker:dev": "tsx src/jobs/run-durable-worker.ts",
    "jobs:run-once": "node dist/src/jobs/run-durable-jobs.js",
    "jobs:worker": "node dist/src/jobs/run-durable-worker.js",
    "jobs:reminders": "node dist/src/jobs/run-learner-reminders.js",
    "reports:test-delivery": "tsx src/jobs/preview-monthly-report-delivery.ts",
    "test": "tsx --test src/tests/**/*.test.ts",
    "test:all": "tsx --test src/tests/**/*.test.ts src/admissions/*.test.ts src/analytics/*.test.ts src/auth/*.test.ts src/notifications/*.test.ts src/settings/*.test.ts",
    "test:integration": "tsx --test src/integration/*.test.ts",
    "test:integration:prepare": "tsx src/integration/prepare-test-database.ts",
    "test:integration:execute": "tsx src/integration/run-full-integration.ts",
    "test:integration:full": "npm run test:integration:prepare && npm run test:integration:execute",
    "typecheck": "tsc --noEmit",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "verify:commerce-read": "tsx scripts/verify-commerce-read.ts",
    "email:preview:account-created": "tsx src/scratch/preview-account-created-email.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.1.0",
    "nodemailer": "^9.0.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.296",
    "pg": "^8.23.0",
    "sanitize-html": "^2.17.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.0",
    "esbuild": "^0.28.2",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
