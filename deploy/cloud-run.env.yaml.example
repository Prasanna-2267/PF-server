NODE_ENV: "production"
HOST: "0.0.0.0"
DATABASE_URL: "postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL: "postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
AUTH_JWT_SECRET: ""
AUTH_ISSUER: "parallax-flow-api"
AUTH_AUDIENCE: "parallax-flow-web"
AUTH_ACCESS_TOKEN_TTL_SECONDS: "900"
AUTH_REFRESH_TOKEN_TTL_SECONDS: "2592000"
CORS_ALLOWED_ORIGINS: "https://parallaxflow.in"
TRUST_PROXY: "true"
JSON_BODY_LIMIT: "1mb"
LOG_LEVEL: "info"
GOOGLE_CLIENT_ID: ""
AUTH_PASSWORD_REGISTRATION_ENABLED: "false"
AUTH_STAGED_REGISTRATION_ENABLED: "false"
AUTH_GOOGLE_REGISTRATION_ENABLED: "false"
RATE_LIMIT_WINDOW_MS: "900000"
RATE_LIMIT_MAX_REQUESTS: "300"
AUTH_RATE_LIMIT_MAX_REQUESTS: "10"
STORAGE_DRIVER: "disabled"
STORAGE_S3_ENDPOINT: ""
STORAGE_S3_REGION: "auto"
STORAGE_S3_BUCKET: ""
STORAGE_S3_ACCESS_KEY_ID: ""
STORAGE_S3_SECRET_ACCESS_KEY: ""
STORAGE_SIGNED_URL_TTL_SECONDS: "900"
EMAIL_WEBHOOK_URL: ""
EMAIL_WEBHOOK_BEARER_TOKEN: ""
EMAIL_PROVIDER: "http"
SMTP_HOST: ""
SMTP_PORT: "465"
SMTP_SECURE: "true"
SMTP_USER: ""
SMTP_PASSWORD: ""
SMTP_FROM: ""
SMTP_REPLY_TO: ""
CONTACT_RECIPIENT_EMAIL: ""
PUBLIC_APP_URL: "https://parallaxflow.in"
PUBLIC_LOGO_URL: ""
SUPPORT_EMAIL: "support@parallaxflow.com"
NEURALWEB_LABS_URL: "https://example.com"
SMS_WEBHOOK_URL: ""
SMS_WEBHOOK_BEARER_TOKEN: ""
PAYMENT_CHECKOUT_URL: ""
PAYMENT_WEBHOOK_SECRET: ""
PAYMENT_BEARER_TOKEN: ""
PAYMENT_PROVIDER_NAME: "http"
FAKE_PAYMENT_ENABLED: "true"
PILOT_FAKE_PAYMENT_ENABLED: "true"
EXPO_PUSH_ENDPOINT: "https://exp.host/--/api/v2/push/send"
EXPO_ACCESS_TOKEN: ""
JOB_WORKER_ID: ""
JOB_WORKER_POLL_INTERVAL_MS: "5000"
JOB_WORKER_BATCH_LIMIT: "50"
JOB_WORKER_RUN_ONCE: "false"
NOTIFICATION_MAINTENANCE_INTERVAL_MS: "300000"
MONTHLY_REPORT_MAINTENANCE_INTERVAL_MS: "21600000"
