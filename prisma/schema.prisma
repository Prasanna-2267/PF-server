// ==================================================

model Broadcast {
  id                      String                  @id @default(uuid()) @db.Uuid
  academyId               String?                 @db.Uuid
  title                   String
  subtitle                String                  @default("")
  message                 String                  @db.Text
  type                    BroadcastType           @default(ANNOUNCEMENT)
  priority                BroadcastPriority       @default(NORMAL)
  status                  BroadcastStatus         @default(DRAFT)
  disabledFrom            BroadcastStatus?
  platform                BroadcastPlatform       @default(BOTH)
  audienceKind            BroadcastAudienceKind   @default(EVERYONE)
  startAt                 DateTime?
  endAt                   DateTime?
  publishedAt             DateTime?
  frequency               BroadcastFrequency      @default(ONCE)
  dismissible             Boolean                 @default(true)
  presentation            BroadcastPresentation   @default(NOTIFICATION)
  displayOrder            BroadcastDisplayOrder   @default(AUTOMATIC)
  customOrderWeight       Int                     @default(50)
  acknowledgementRequired Boolean                 @default(false)
  repeatBehavior          BroadcastRepeatBehavior @default(NEVER)
  showInWhatsNew          Boolean                 @default(false)

  // Cached Aggregated Analytics Counters
  reachedCount      Int @default(0)
  viewedCount       Int @default(0)
  uniqueViewsCount  Int @default(0)
  clickedCount      Int @default(0)
  dismissedCount    Int @default(0)
  acknowledgedCount Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  academy        Academy?                    @relation(fields: [academyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  placements     BroadcastPlacementSetting[]
  cta            BroadcastCta?
  image          BroadcastImage?
  courseTargets  BroadcastCourseTarget[]
  packageTargets BroadcastPackageTarget[]
  academyTargets BroadcastAcademyTarget[]
  timeline       BroadcastTimelineEvent[]
  userEvents     BroadcastUserEvent[]

  @@index([academyId, status, deletedAt])
  @@index([status, startAt, endAt, deletedAt])
  @@index([platform, audienceKind])
  @@index([priority, displayOrder])
  @@index([showInWhatsNew, status])
  @@index([createdAt])
}

model BroadcastPlacementSetting {
  id          String             @id @default(uuid()) @db.Uuid
  broadcastId String             @db.Uuid
  placement   BroadcastPlacement

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([broadcastId, placement])
  @@index([broadcastId])
  @@index([placement])
}

model BroadcastCta {
  id          String             @id @default(uuid()) @db.Uuid
  broadcastId String             @unique @db.Uuid
  enabled     Boolean            @default(true)
  text        String
  action      BroadcastCtaAction @default(INTERNAL_ROUTE)
  destination String

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model BroadcastImage {
  id          String   @id @default(uuid()) @db.Uuid
  broadcastId String   @unique @db.Uuid
  name        String
  mimeType    String
  size        BigInt
  storagePath String
  createdAt   DateTime @default(now())

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model BroadcastCourseTarget {
  id          String @id @default(uuid()) @db.Uuid
  broadcastId String @db.Uuid
  courseId    String @db.Uuid

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([broadcastId, courseId])
  @@index([broadcastId])
  @@index([courseId])
}

model BroadcastPackageTarget {
  id          String @id @default(uuid()) @db.Uuid
  broadcastId String @db.Uuid
  packageId   String @db.Uuid

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  package   Package   @relation(fields: [packageId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([broadcastId, packageId])
  @@index([broadcastId])
  @@index([packageId])
}

model BroadcastTimelineEvent {
  id          String                  @id @default(uuid()) @db.Uuid
  broadcastId String                  @db.Uuid
  actorId     String                  @db.Uuid
  action      BroadcastTimelineAction
  description String                  @db.Text
  timestamp   DateTime                @default(now())

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor     User      @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([broadcastId, timestamp])
  @@index([actorId])
}

model BroadcastUserEvent {
  id          String             @id @default(uuid()) @db.Uuid
  broadcastId String             @db.Uuid
  userId      String             @db.Uuid
  eventType   BroadcastEventType
  occurredAt  DateTime           @default(now())

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([broadcastId, userId, eventType])
  @@index([broadcastId, eventType])
  @@index([userId, broadcastId, eventType])
  @@index([occurredAt])
}

