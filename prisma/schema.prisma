enum ContentKind {
  FOLDER
  FILE
}

enum ContentAccessType {
  FREE
  PAID
}

enum ContentValidityMode {
  PERMANENT
  EXAM_DATE_OFFSET
}

enum AccessDurationUnit {
  DAYS
  WEEKS
  MONTHS
}

enum ContentEntityType {
  EXAM
  STAGE
  SUBJECT
  CHAPTER
  COURSE
  CATEGORY
  LESSON
  STUDY_MATERIAL
  GOVERNMENT_DOCUMENT
  QUESTION_PAPER
  REFERENCE_MATERIAL
  PREMIUM_NOTE
  MONTHLY_REPORT
  MEDIA
  OTHER
}

enum ContentStatus {
  PUBLISHED
  ARCHIVED
}

model ContentItem {
  id       String  @id @default(uuid()) @db.Uuid
  courseId String  @db.Uuid
  parentId String? @db.Uuid

  kind ContentKind
  name String

  size        BigInt  @default(0)
  mimeType    String?
  storagePath String?

  description String             @default("")
  entityType  ContentEntityType?

  accessType ContentAccessType @default(FREE)
  price      Decimal?          @db.Decimal(10, 2)

  // Paid resources are permanent unless an Admin explicitly chooses an
  // exam-relative validity window. Existing content therefore keeps its
  // current behaviour after this additive migration.
  validityMode       ContentValidityMode @default(PERMANENT)
  validityOffsetDays Int?

  // Commercial access policy for future purchases. A null value/unit pair
  // means permanent access. Expiry is snapshotted onto Entitlement when paid.
  accessDurationValue Int?
  accessDurationUnit  AccessDurationUnit?

  status ContentStatus @default(PUBLISHED)

  displayOrder Int @default(0)

  lastOpenedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  course Course       @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parent ContentItem? @relation("ContentHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  children                 ContentItem[]             @relation("ContentHierarchy")
  sampleImages             ContentSampleImage[]
  storeSections            ContentStoreSection[]
  locations                ContentLocationSetting[]
  packageItems             PackageItem[]
  orderItems               OrderItem[]
  entitlements             Entitlement[]
  viewerSessions           NoteViewerSession[]
  learnerStates            LearnerNoteState[]
  studyTasks               LearnerStudyTask[]
  workloadEstimate         StudyWorkloadEstimate?
  questionLinks            QuestionContentLink[]
  practiceSessionMaterials PracticeSessionMaterial[]
  monthlyReportsAsProduct  LearnerMonthlyReport[]    @relation("MonthlyReportProduct")
  attachedLinks            ContentAttachedLink[]

  @@index([courseId, parentId, deletedAt, displayOrder])
  @@index([kind, accessType])
  @@index([status])
  @@index([storagePath])
}

model ContentAttachedLink {
  id            String    @id @default(uuid()) @db.Uuid
  contentItemId String    @db.Uuid
  url           String    @db.VarChar(2048)
  description   String    @db.VarChar(2000)
  createdById   String    @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy   User        @relation("ContentAttachedLinkCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([contentItemId, deletedAt, createdAt])
  @@index([createdById])
}

model ContentLocationSetting {
  id       String  @id @default(uuid()) @db.Uuid
  courseId String  @db.Uuid
  folderId String? @db.Uuid

  pageHeading String @default("untitled_page")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course       @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  folder ContentItem? @relation(fields: [folderId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([courseId])
}

enum SampleImageRole {
  PDF_FIRST_PAGE
  ADMIN_PREVIEW
}

model ContentSampleImage {
  id        String          @id @default(uuid()) @db.Uuid
  contentId String          @db.Uuid
  role      SampleImageRole @default(ADMIN_PREVIEW)

  name        String
  mimeType    String
  size        BigInt
  storagePath String

  displayOrder Int @default(0)

  createdAt DateTime @default(now())

  contentItem ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([contentId, role])
  @@index([contentId, displayOrder])
}

model ContentStoreSection {
  id        String @id @default(uuid()) @db.Uuid
  contentId String @db.Uuid

  heading      String
  content      String
  displayOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contentItem ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([contentId, displayOrder])
}

enum MerchandisingMode {
  AUTO
  HYBRID
  MANUAL
}

model StoreMerchandisingSection {
  id              String            @id @default(uuid()) @db.Uuid
  key             String            @unique
  title           String
  subtitle        String?
  mode            MerchandisingMode @default(AUTO)
  limit           Int               @default(8)
  dateWindowDays  Int?
  pinnedItemIds   String[]          @default([])
  excludedItemIds String[]          @default([])
  isEnabled       Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PackageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Package {
  id                  String              @id @default(uuid()) @db.Uuid
  courseId            String              @db.Uuid
  title               String
  slug                String
  description         String              @default("")
  price               Decimal             @default(0.00) @db.Decimal(10, 2)
  status              PackageStatus       @default(DRAFT)
  // Packages (including Question Bank products) use the same purchase-time
  // duration policy as individually sold content.
  accessDurationValue Int?
  accessDurationUnit  AccessDurationUnit?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  course           Course                   @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items            PackageItem[]
  questionBanks    PackageQuestionBank[]
  orderItems       OrderItem[]
  couponTargets    CouponTarget[]
  entitlements     Entitlement[]
  broadcastTargets BroadcastPackageTarget[]
  questionBank     QuestionBank?

  @@index([courseId, status, deletedAt])
  @@index([createdAt])
}

// A Question Bank is the durable practice-product container. Excel remains
// only an import mechanism, while Package remains the existing Store product
// and Entitlement source. This keeps commercial access and question grouping
// separate without duplicating the established purchase system.
model QuestionBank {
  id                  String              @id @default(uuid()) @db.Uuid
  academyId           String?             @db.Uuid
  courseId            String              @db.Uuid
  packageId           String?             @unique @db.Uuid
  name                String
  slug                String
  description         String              @default("")
  accessType          ContentAccessType   @default(FREE)
  price               Decimal             @default(0.00) @db.Decimal(10, 2)
  accessDurationValue Int?
  accessDurationUnit  AccessDurationUnit?
  // A bank can contain both normal and case-based MCQs. Question kind belongs
  // to Question, never to the commercial/container record.
  status              PackageStatus       @default(DRAFT)
  createdById         String?             @db.Uuid
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?

  academy          Academy?              @relation(fields: [academyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  course           Course                @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  package          Package?              @relation(fields: [packageId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  packages         PackageQuestionBank[]
  questions        Question[]
  practiceSessions PracticeSession[]
  orderItems       OrderItem[]
  entitlements     Entitlement[]

  @@unique([courseId, slug])
  @@index([academyId, status, deletedAt])
  @@index([courseId, accessType, status, deletedAt])
}

model PackageItem {
  id            String   @id @default(uuid()) @db.Uuid
  packageId     String   @db.Uuid
  contentItemId String   @db.Uuid
  displayOrder  Int      @default(0)
  addedAt       DateTime @default(now())

  package     Package     @relation(fields: [packageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([packageId, contentItemId])
  @@index([packageId, displayOrder])
  @@index([contentItemId])
}

// Explicit package membership for practice products. A Question Bank remains
// an independent product/container and is never duplicated when included in a
// mixed learning package.
model PackageQuestionBank {
  id             String   @id @default(uuid()) @db.Uuid
  packageId      String   @db.Uuid
  questionBankId String   @db.Uuid
  displayOrder   Int      @default(0)
  addedAt        DateTime @default(now())

  package      Package      @relation(fields: [packageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  questionBank QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([packageId, questionBankId])
  @@index([packageId, displayOrder])
  @@index([questionBankId])
}

model TaxonomyChapter {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @db.Uuid
  subjectId String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course           Course            @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subject          Subject           @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lessons          TaxonomyLesson[]
  questions        Question[]
  caseSubQuestions CaseSubQuestion[]
  practiceSessions PracticeSession[]

  @@index([subjectId])
  @@index([courseId])
}

model TaxonomyLesson {
  id        String   @id @default(uuid()) @db.Uuid
  chapterId String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter          TaxonomyChapter   @relation(fields: [chapterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  topics           TaxonomyTopic[]
  questions        Question[]
  caseSubQuestions CaseSubQuestion[]
  practiceSessions PracticeSession[]

  @@index([chapterId])
}

model TaxonomyTopic {
  id        String   @id @default(uuid()) @db.Uuid
  lessonId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson           TaxonomyLesson    @relation(fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  questions        Question[]
  caseSubQuestions CaseSubQuestion[]
  practiceSessions PracticeSession[]

  @@index([lessonId])
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionDifficulty {
  FOUNDATION
  INTERMEDIATE
  ADVANCED
}

enum QuestionKind {
  NORMAL_MCQ
  NORMAL_DESCRIPTIVE
  CASE_MCQ
  CASE_DESCRIPTIVE
}

enum PracticeCollection {
  PYQ
  RTP
  MTP
  ORIGINAL
  QUESTION_BANK
}

enum CaseClassificationMode {
  ENTIRE_CASE
  INDIVIDUAL_SUB_QUESTIONS
}

model Question {
  id                                 String                 @id @default(uuid()) @db.Uuid
  academyId                          String?                @db.Uuid
  kind                               QuestionKind
  status                             QuestionStatus         @default(DRAFT)
  difficulty                         QuestionDifficulty     @default(INTERMEDIATE)
  questionHtml                       String                 @default("")
  answerHtml                         String                 @default("")
  correctOptionId                    String?                @db.VarChar(1)
  correctExplanationHtml             String                 @default("")
  premiumWrongOptionsExplanationHtml String                 @default("")
  caseHtml                           String                 @default("")
  caseId                             String?
  classificationMode                 CaseClassificationMode @default(ENTIRE_CASE)

  courseId           String?            @db.Uuid
  subjectId          String?            @db.Uuid
  chapterId          String?            @db.Uuid
  lessonId           String?            @db.Uuid
  topicId            String?            @db.Uuid
  practiceCollection PracticeCollection @default(ORIGINAL)
  questionBankId     String?            @db.Uuid
  practiceYear       Int?
  examName           String             @default("")
  chapterName        String             @default("")
  conceptName        String             @default("")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  academy                  Academy?                  @relation(fields: [academyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  course                   Course?                   @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subject                  Subject?                  @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chapter                  TaxonomyChapter?          @relation(fields: [chapterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lesson                   TaxonomyLesson?           @relation(fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  topic                    TaxonomyTopic?            @relation(fields: [topicId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  options                  QuestionOption[]
  subQuestions             CaseSubQuestion[]
  practiceSessionQuestions PracticeSessionQuestion[]
  contentLinks             QuestionContentLink[]
  questionBank             QuestionBank?             @relation(fields: [questionBankId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([academyId, status, deletedAt])
  @@index([courseId, subjectId, chapterId, lessonId, topicId])
  @@index([kind, status, difficulty, deletedAt])
  @@index([caseId])
  @@index([createdAt])
  @@index([courseId, practiceCollection, practiceYear, status])
  @@index([questionBankId, status, deletedAt])
}

// Questions are intentionally linked to the same course content files that
// drive Notes and Store entitlements. Access is derived from these links; a
// question never carries an independent paid/free flag.
model QuestionContentLink {
  questionId    String   @db.Uuid
  contentItemId String   @db.Uuid
  createdAt     DateTime @default(now())

  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([questionId, contentItemId])
  @@index([contentItemId, questionId])
}

model QuestionOption {
  id            String  @id @default(uuid()) @db.Uuid
  questionId    String? @db.Uuid
  subQuestionId String? @db.Uuid
  optionLabel   String  @db.VarChar(1)
  html          String  @default("")
  displayOrder  Int     @default(0)

  question    Question?        @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subQuestion CaseSubQuestion? @relation(fields: [subQuestionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([questionId])
  @@index([subQuestionId])
}

model CaseSubQuestion {
  id                                 String  @id @default(uuid()) @db.Uuid
  questionId                         String  @db.Uuid
  questionHtml                       String  @default("")
  correctOptionId                    String? @db.VarChar(1)
  correctExplanationHtml             String  @default("")
  premiumWrongOptionsExplanationHtml String  @default("")
  answerHtml                         String  @default("")
  displayOrder                       Int     @default(0)

  courseId    String? @db.Uuid
  subjectId   String? @db.Uuid
  chapterId   String? @db.Uuid
  lessonId    String? @db.Uuid
  topicId     String? @db.Uuid
  examName    String  @default("")
  chapterName String  @default("")
  conceptName String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentQuestion           Question                  @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  course                   Course?                   @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subject                  Subject?                  @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chapter                  TaxonomyChapter?          @relation(fields: [chapterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lesson                   TaxonomyLesson?           @relation(fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  topic                    TaxonomyTopic?            @relation(fields: [topicId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  options                  QuestionOption[]
  practiceSessionQuestions PracticeSessionQuestion[]

  @@index([questionId, displayOrder])
}

enum PracticeSourceKind {
  ARCHIVE
}

enum PracticeMode {
  MCQ
  CASE_STUDY
  QUESTION_BANK
  WRONG_ANSWERS
  REVISIT
}

enum PracticeAnswerFormat {
  MCQ
  DESCRIPTIVE
  CASE_STUDY
}

enum PracticeAccessPolicy {
  FREE
  PAID
}

enum PracticeSessionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  ABANDONED
}

enum PracticeNavigatorState {
  UNANSWERED
  ANSWERED_CORRECT
  ANSWERED_WRONG
  MARKED_REVIEW
  LOCKED_WRONG
  AWAITING_REVIEW
}

model PracticeSession {
  id                 String                @id @default(uuid()) @db.Uuid
  userId             String                @db.Uuid
  courseId           String                @db.Uuid
  sourceKind         PracticeSourceKind
  mode               PracticeMode          @default(MCQ)
  subjectId          String?               @db.Uuid
  chapterId          String?               @db.Uuid
  lessonId           String?               @db.Uuid
  topicId            String?               @db.Uuid
  collection         PracticeCollection?
  questionBankId     String?               @db.Uuid
  year               Int?
  answerFormat       PracticeAnswerFormat
  accessPolicy       PracticeAccessPolicy
  timerSeconds       Int?
  questionCount      Int
  unlimitedQuestions Boolean               @default(false)
  answeredCount      Int                   @default(0)
  correctCount       Int                   @default(0)
  wrongCount         Int                   @default(0)
  markedReviewCount  Int                   @default(0)
  status             PracticeSessionStatus @default(ACTIVE)
  startedAt          DateTime              @default(now())
  expiresAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  course       Course                    @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subject      Subject?                  @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chapter      TaxonomyChapter?          @relation(fields: [chapterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lesson       TaxonomyLesson?           @relation(fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  topic        TaxonomyTopic?            @relation(fields: [topicId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  questionBank QuestionBank?             @relation(fields: [questionBankId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  questions    PracticeSessionQuestion[]
  materials    PracticeSessionMaterial[]

  @@index([userId, status, startedAt])
  @@index([courseId, subjectId, chapterId, startedAt])
  @@index([questionBankId, status, startedAt])
  @@index([expiresAt, status])
}

model PracticeSessionMaterial {
  sessionId     String   @db.Uuid
  contentItemId String   @db.Uuid
  createdAt     DateTime @default(now())

  session     PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contentItem ContentItem     @relation(fields: [contentItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([sessionId, contentItemId])
  @@index([contentItemId, sessionId])
}

model PracticeSessionQuestion {
  id                          String                 @id @default(uuid()) @db.Uuid
  sessionId                   String                 @db.Uuid
  questionId                  String                 @db.Uuid
  subQuestionId               String?                @db.Uuid
  sequence                    Int
  kind                        QuestionKind
  difficulty                  QuestionDifficulty
  promptHtml                  String
  caseHtml                    String                 @default("")
  optionsSnapshot             Json
  correctOptionLabel          String?                @db.VarChar(1)
  answerHtml                  String                 @default("")
  correctExplanationHtml      String                 @default("")
  premiumWrongExplanationHtml String                 @default("")
  subjectId                   String?                @db.Uuid
  chapterId                   String?                @db.Uuid
  lessonId                    String?                @db.Uuid
  topicId                     String?                @db.Uuid
  examName                    String                 @default("")
  chapterName                 String                 @default("")
  conceptName                 String                 @default("")
  navigatorState              PracticeNavigatorState @default(UNANSWERED)
  attemptCount                Int                    @default(0)
  final                       Boolean                @default(false)
  lastAttemptAt               DateTime?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt

  session     PracticeSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  question    Question          @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subQuestion CaseSubQuestion?  @relation(fields: [subQuestionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attempts    PracticeAttempt[]

  @@unique([sessionId, sequence])
  @@index([sessionId, navigatorState, sequence])
  @@index([questionId])
  @@index([subQuestionId])
  @@index([chapterId, topicId])
}

model PracticeAttempt {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid
  sessionQuestionId   String   @db.Uuid
  attemptNumber       Int
  clientAttemptId     String   @db.VarChar(100)
  answerOptionLabel   String?  @db.VarChar(1)
  answerText          String?
  correct             Boolean?
  durationMs          Int?
  explanationReleased Boolean  @default(false)
  createdAt           DateTime @default(now())

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sessionQuestion PracticeSessionQuestion @relation(fields: [sessionQuestionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([sessionQuestionId, attemptNumber])
  @@unique([sessionQuestionId, clientAttemptId])
  @@index([userId, createdAt])
  @@index([sessionQuestionId, createdAt])
}

