generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SessionPlatform {
  ANDROID
  WEB
  IOS
  UNKNOWN
}

model User {
  id                             String                         @id @db.Uuid
  email                          String                         @unique
  fullName                       String
  phone                          String?
  avatarStoragePath              String?
  status                         UserStatus                     @default(ACTIVE)
  roleId                         String                         @db.Uuid
  lastLoginAt                    DateTime?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  deletedAt                      DateTime?
  role                           Role                           @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sessions                       UserSession[]
  passwordCredential             PasswordCredential?
  orders                         Order[]
  couponRedemptions              CouponRedemption[]
  entitlements                   Entitlement[]
  adminGrants                    Entitlement[]                  @relation("AdminGrants")
  auditEventsAsActor             AuditEvent[]                   @relation("AuditActor")
  auditEventsAsTarget            AuditEvent[]                   @relation("AuditTarget")
  broadcastTimeline              BroadcastTimelineEvent[]
  broadcastUserEvents            BroadcastUserEvent[]
  academyMemberships             AcademyMembership[]
  academyEnrollments             AcademyCourseEnrollment[]
  academyInvitationsSent         AcademyInvitation[]            @relation("AcademyInviter")
  academyQrSessionsCreated       AcademyQrSession[]             @relation("QrCreator")
  platformSettingsUpdated        PlatformSetting[]              @relation("PlatformSettingsUpdated")
  systemAuditLogsAsActor         SystemAuditLog[]               @relation("SystemAuditActor")
  securityEventsForUser          SecurityEvent[]                @relation("SecurityEventsForUser")
  securityEventsAsActor          SecurityEvent[]                @relation("SecurityEventsAsActor")
  admissionBatchesCreated        AdmissionBatch[]               @relation("AdmissionBatchCreator")
  admissionRecordsAsStudent      AdmissionRecord[]              @relation("AdmissionStudent")
  admissionRecordsCreated        AdmissionRecord[]              @relation("AdmissionRecordCreator")
  admissionCodesCreated          AdmissionCode[]                @relation("AdmissionCodeCreator")
  sentNotifications              Notification[]                 @relation("SentNotifications")
  receivedNotificationRecipients NotificationRecipient[]        @relation("ReceivedNotificationRecipients")
  notificationIndividualTargets  NotificationIndividualTarget[]
  storageUploads                 StorageUpload[]
  backgroundJobsCreated          BackgroundJob[]                @relation("BackgroundJobCreator")
  contactSubmissions             ContactSubmission[]
  activeAcademyPreference        UserAcademyPreference?
  notificationDeliveries         NotificationDelivery[]
  learnerPreference              LearnerPreference?
  noteViewerSessions             NoteViewerSession[]
  learnerNoteStates              LearnerNoteState[]
  noteRevisionEvents             NoteRevisionEvent[]
  practiceSessions               PracticeSession[]
  practiceAttempts               PracticeAttempt[]
  rewardWallet                   RewardWallet?
  rewardClaims                   RewardClaim[]
  rewardLedgerEntries            RewardLedgerEntry[]
  focusSessions                  FocusSession[]
  dailyActivities                LearnerDailyActivity[]
  streakState                    LearnerStreakState?
  streakDays                     LearnerStreakDay[]
  studyPlans                     LearnerStudyPlan[]
  studyTasks                     LearnerStudyTask[]
  monthlyReports                 LearnerMonthlyReport[]
  monthlyReportViewerSessions    MonthlyReportViewerSession[]
  mobilePushTokens               MobilePushToken[]
  learnerNotificationPreference  LearnerNotificationPreference?
  learnerNotifications           LearnerNotification[]
  accountVerificationChallenges  AccountVerificationChallenge[]
  academyProfilesCreated         AcademyProfile[]               @relation("AcademyProfileCreator")
  deviceBinding                  StudentDeviceBinding?          @relation("BoundStudentDevice")
  deviceResetApprovals           StudentDeviceBinding[]         @relation("DeviceResetApprover")
  contentAttachedLinksCreated    ContentAttachedLink[]          @relation("ContentAttachedLinkCreator")

  @@index([roleId])
  @@index([status, createdAt])
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique
  name            String
  description     String
  isSystem        Boolean          @default(true)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           User[]
  rolePermissions RolePermission[]
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique
  module          String
  action          String
  description     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserSession {
  id                          String                       @id @default(uuid()) @db.Uuid
  userId                      String                       @db.Uuid
  authSessionId               String                       @unique
  deviceName                  String?
  platform                    SessionPlatform              @default(UNKNOWN)
  userAgent                   String?
  ipAddress                   String?
  location                    String?
  createdAt                   DateTime                     @default(now())
  lastSeenAt                  DateTime                     @default(now())
  expiresAt                   DateTime
  revokedAt                   DateTime?
  refreshTokenHash            String?                      @db.VarChar(64)
  rotationCounter             Int                          @default(0)
  lastRotatedAt               DateTime?
  deviceIdHash                String?                      @db.VarChar(64)
  deviceBindingVersion        Int?
  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  noteViewerSessions          NoteViewerSession[]
  monthlyReportViewerSessions MonthlyReportViewerSession[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([userId, lastSeenAt])
}

model PasswordCredential {
  userId            String   @id @db.Uuid
  passwordHash      String
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model RegistrationChallenge {
  id                     String          @id @default(uuid()) @db.Uuid
  email                  String
  phone                  String
  fullName               String
  passwordHash           String?
  emailOtpHash           String?         @db.VarChar(64)
  mobileOtpHash          String?         @db.VarChar(64)
  emailAttempts          Int             @default(0)
  mobileAttempts         Int             @default(0)
  emailResendCount       Int             @default(0)
  mobileResendCount      Int             @default(0)
  emailSentAt            DateTime?
  mobileSentAt           DateTime?
  emailVerifiedAt        DateTime?
  mobileVerifiedAt       DateTime?
  deviceIdHash           String?         @db.VarChar(64)
  deviceSecretHash       String?         @db.VarChar(64)
  deviceName             String?
  platform               SessionPlatform @default(UNKNOWN)
  devicePolicyAcceptedAt DateTime?
  expiresAt              DateTime
  completedAt            DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([email, completedAt, cancelledAt])
  @@index([expiresAt])
}

model StudentDeviceBinding {
  userId            String          @id @db.Uuid
  deviceIdHash      String          @db.VarChar(64)
  deviceSecretHash  String          @db.VarChar(64)
  deviceName        String?
  platform          SessionPlatform @default(UNKNOWN)
  bindingVersion    Int             @default(1)
  boundAt           DateTime        @default(now())
  lastVerifiedAt    DateTime        @default(now())
  resetApprovedAt   DateTime?
  resetApprovedById String?         @db.Uuid
  resetConsumedAt   DateTime?
  updatedAt         DateTime        @updatedAt

  user            User  @relation("BoundStudentDevice", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resetApprovedBy User? @relation("DeviceResetApprover", fields: [resetApprovedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([deviceIdHash])
  @@index([resetApprovedAt, resetConsumedAt])
}

enum ExamDatePrecision {
  DAY
  MONTH
}

enum LearnerTheme {
  LIGHT
  DARK
}

enum AccountVerificationPurpose {
  EMAIL_CHANGE
  MOBILE_CHANGE
  DELETE_ACCOUNT
}

model LearnerPreference {
  userId                String             @id @db.Uuid
  selectedCourseId      String?            @db.Uuid
  examDate              DateTime?
  examDatePrecision     ExamDatePrecision?
  academyReference      String?
  dailyTargetMinutes    Int                @default(120)
  timezone              String             @default("Asia/Kolkata")
  language              String             @default("English")
  reminderTime          String             @default("19:00")
  preferredTheme        LearnerTheme       @default(DARK)
  onboardingCompletedAt DateTime?
  version               Int                @default(1)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  selectedCourse        Course?            @relation(fields: [selectedCourseId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([selectedCourseId])
}

model AccountVerificationChallenge {
  id          String                     @id @default(uuid()) @db.Uuid
  userId      String                     @db.Uuid
  purpose     AccountVerificationPurpose
  targetValue String                     @db.VarChar(320)
  previousValue String?                  @db.VarChar(320)
  currentVerifiedAt DateTime?
  otpHash     String?                    @db.VarChar(64)
  attempts    Int                        @default(0)
  resendCount Int                        @default(0)
  sentAt      DateTime?
  expiresAt   DateTime
  consumedAt  DateTime?
  cancelledAt DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, purpose, consumedAt, cancelledAt])
  @@index([expiresAt])
}

enum MobilePushPlatform {
  ANDROID
  IOS
}

enum LearnerNotificationCategory {
  BROADCAST
  DAILY_PLAN
  REVISION_DUE
  RESOURCE_EXPIRY
  STREAK_RISK
  SECURITY
  ACCOUNT
}

enum LearnerNotificationDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  CANCELLED
}

model MobilePushToken {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @db.Uuid
  token             String             @unique @db.VarChar(220)
  platform          MobilePushPlatform
  installationId    String             @db.VarChar(160)
  deviceName        String?            @db.VarChar(160)
  appVersion        String?            @db.VarChar(40)
  enabled           Boolean            @default(true)
  lastSeenAt        DateTime           @default(now())
  revokedAt         DateTime?
  consecutiveErrors Int                @default(0)
  lastError         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user       User                              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  deliveries LearnerNotificationPushDelivery[]

  @@unique([userId, installationId])
  @@index([userId, enabled, revokedAt])
}

model LearnerNotificationPreference {
  userId                String   @id @db.Uuid
  pushEnabled           Boolean  @default(true)
  broadcastEnabled      Boolean  @default(true)
  dailyPlanEnabled      Boolean  @default(true)
  revisionDueEnabled    Boolean  @default(true)
  resourceExpiryEnabled Boolean  @default(true)
  streakRiskEnabled     Boolean  @default(true)
  securityEnabled       Boolean  @default(true)
  accountEnabled        Boolean  @default(true)
  quietHoursEnabled     Boolean  @default(false)
  quietHoursStart       String   @default("22:00") @db.VarChar(5)
  quietHoursEnd         String   @default("07:00") @db.VarChar(5)
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model LearnerNotification {
  id           String                      @id @default(uuid()) @db.Uuid
  userId       String                      @db.Uuid
  category     LearnerNotificationCategory
  title        String                      @db.VarChar(180)
  body         String                      @db.Text
  sourceKey    String                      @db.VarChar(240)
  data         Json?
  scheduledFor DateTime                    @default(now())
  readAt       DateTime?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  user       User                              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  deliveries LearnerNotificationPushDelivery[]

  @@unique([userId, sourceKey])
  @@index([userId, readAt, createdAt])
  @@index([category, scheduledFor])
}

model LearnerNotificationPushDelivery {
  id                String                            @id @default(uuid()) @db.Uuid
  notificationId    String                            @db.Uuid
  pushTokenId       String                            @db.Uuid
  status            LearnerNotificationDeliveryStatus @default(PENDING)
  attemptCount      Int                               @default(0)
  providerMessageId String?
  lastError         String?
  nextAttemptAt     DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime                          @default(now())
  updatedAt         DateTime                          @updatedAt

  notification LearnerNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  pushToken    MobilePushToken     @relation(fields: [pushTokenId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([notificationId, pushTokenId])
  @@index([status, nextAttemptAt])
  @@index([pushTokenId, createdAt])
}

enum RewardClaimStatus {
  PENDING
  CLAIMED
  EXPIRED
  CANCELLED
}

enum RewardLedgerKind {
  EARN
  SPEND
  EXPIRE
  ADJUST
}

enum RewardSourceType {
  DAILY_FOCUS
  STREAK
  HEART_RECOVERY
  ADMIN_ADJUSTMENT
}

model RewardWallet {
  userId      String   @id @db.Uuid
  points      Int      @default(0)
  hearts      Int      @default(3)
  heartPeriod String?  @db.VarChar(7)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([updatedAt])
}

model RewardClaim {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @db.Uuid
  sourceType    RewardSourceType
  sourceId      String            @db.VarChar(160)
  points        Int               @default(0)
  hearts        Int               @default(0)
  policyVersion String            @db.VarChar(80)
  status        RewardClaimStatus @default(PENDING)
  availableAt   DateTime          @default(now())
  expiresAt     DateTime?
  claimedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ledgerEntry RewardLedgerEntry?

  @@unique([userId, sourceType, sourceId, policyVersion])
  @@index([userId, status, availableAt])
  @@index([expiresAt, status])
}

model RewardLedgerEntry {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @db.Uuid
  kind               RewardLedgerKind
  sourceType         RewardSourceType
  sourceId           String           @db.VarChar(160)
  pointsDelta        Int              @default(0)
  heartsDelta        Int              @default(0)
  pointsBalanceAfter Int
  heartsBalanceAfter Int
  policyVersion      String           @db.VarChar(80)
  idempotencyKey     String           @db.VarChar(200)
  claimId            String?          @unique @db.Uuid
  createdAt          DateTime         @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  claim       RewardClaim?      @relation(fields: [claimId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  recoveryDay LearnerStreakDay?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt, id])
  @@index([sourceType, sourceId])
}

enum FocusSessionSource {
  HOME
  TRACKER
  STUDY_TASK
  NOTE
}

enum FocusSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum StreakDayStatus {
  ACTIVE
  PROTECTED
}

model FocusSession {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @db.Uuid
  source                 FocusSessionSource
  sourceId               String?            @db.Uuid
  plannedDurationSeconds Int?
  status                 FocusSessionStatus @default(ACTIVE)
  startedAt              DateTime           @default(now())
  lastHeartbeatAt        DateTime           @default(now())
  checkedOutAt           DateTime?
  abandonedAt            DateTime?
  durationSeconds        Int?
  checkoutIdempotencyKey String?            @db.VarChar(200)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, checkoutIdempotencyKey])
  @@index([userId, status, startedAt])
  @@index([userId, startedAt, id])
  @@index([lastHeartbeatAt, status])
}

model LearnerDailyActivity {
  userId            String   @db.Uuid
  localDate         DateTime @db.Date
  timezone          String   @db.VarChar(80)
  targetMinutes     Int
  focusSeconds      Int      @default(0)
  readingSeconds    Int      @default(0)
  practiceSeconds   Int      @default(0)
  revisionSeconds   Int      @default(0)
  focusSessionCount Int      @default(0)
  qualifiesStreak   Boolean  @default(false)
  goalCompleted     Boolean  @default(false)
  lastActivityAt    DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, localDate])
  @@index([userId, localDate])
  @@index([localDate, qualifiesStreak])
}

enum StudyPlanTaskType {
  READ_NOTE
  CONTINUE_NOTE
  REVISE_NOTE
  PRACTICE_WEAK_CONCEPT
  MANUAL
}

enum StudyPlanTaskSource {
  SYLLABUS_PLAN
  REVISION_DUE
  CONTINUE_RESOURCE
  CARRY_OVER
  WEAK_CONCEPT
  MANUAL
}

enum StudyPlanTaskStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  RESCHEDULED
  REPLACED
}

enum StudyEstimateSource {
  ADMIN
  FALLBACK_V1
  LEARNER
}

model LearnerStudyPlan {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  courseId         String   @db.Uuid
  localDate        DateTime @db.Date
  timezone         String   @db.VarChar(80)
  availableMinutes Int
  algorithmVersion String   @db.VarChar(80)
  generation       Int      @default(1)
  generatedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  course Course             @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tasks  LearnerStudyTask[]

  @@unique([userId, localDate])
  @@index([userId, localDate])
  @@index([courseId, localDate])
}

model LearnerStudyTask {
  id                 String              @id @default(uuid()) @db.Uuid
  planId             String              @db.Uuid
  userId             String              @db.Uuid
  contentItemId      String?             @db.Uuid
  type               StudyPlanTaskType
  source             StudyPlanTaskSource
  status             StudyPlanTaskStatus @default(PLANNED)
  estimateSource     StudyEstimateSource
  title              String              @db.VarChar(180)
  reason             String              @db.VarChar(320)
  plannedMinutes     Int
  actualMinutes      Int?
  priority           Int
  sequence           Int
  startedAt          DateTime?
  completedAt        DateTime?
  skippedAt          DateTime?
  rescheduledForDate DateTime?           @db.Date
  hiddenAt           DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  plan        LearnerStudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contentItem ContentItem?     @relation(fields: [contentItemId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, status, updatedAt])
  @@index([planId, sequence])
  @@index([contentItemId, status])
  @@index([rescheduledForDate])
}

model StudyWorkloadEstimate {
  contentItemId            String   @id @db.Uuid
  estimatedReadingMinutes  Int
  estimatedRevisionMinutes Int
  version                  Int      @default(1)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([updatedAt])
}

model LearnerMonthlyReport {
  id                   String              @id @default(uuid()) @db.Uuid
  userId               String              @db.Uuid
  courseId             String              @db.Uuid
  yearMonth            String              @db.VarChar(7)
  timezone             String              @db.VarChar(80)
  courseCodeSnapshot   String              @db.VarChar(80)
  courseNameSnapshot   String              @db.VarChar(180)
  periodStart          DateTime            @db.Date
  periodEndExclusive   DateTime            @db.Date
  totalStudySeconds    Int
  focusSeconds         Int
  readingSeconds       Int
  practiceSeconds      Int
  revisionSeconds      Int
  activeDays           Int
  goalDays             Int
  streakDays           Int
  protectedDays        Int
  notesCompleted       Int
  revisionsCompleted   Int
  studyTasksCompleted  Int
  totalNotes           Int
  syllabusCompleted    Int
  syllabusPercent      Int
  weeklyStudySeconds   Json
  algorithmVersion     String              @db.VarChar(80)
  productContentItemId String?             @db.Uuid
  entitlementId        String?             @db.Uuid
  orderId              String?             @db.Uuid
  status               MonthlyReportStatus @default(PENDING)
  snapshotJson         Json?
  sourceDataHash       String?             @db.VarChar(64)
  storageKey           String?
  pdfChecksumSha256    String?             @db.VarChar(64)
  pdfSizeBytes         BigInt?
  version              Int                 @default(1)
  failureCode          String?             @db.VarChar(80)
  generatedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  course         Course                       @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product        ContentItem?                 @relation("MonthlyReportProduct", fields: [productContentItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  entitlement    Entitlement?                 @relation(fields: [entitlementId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  order          Order?                       @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  viewerSessions MonthlyReportViewerSession[]

  @@unique([userId, yearMonth])
  @@index([userId, periodStart])
  @@index([courseId, periodStart])
  @@index([userId, status, periodStart])
  @@index([entitlementId])
  @@index([orderId])
}

enum MonthlyReportStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

model MonthlyReportViewerSession {
  id            String                  @id @default(uuid()) @db.Uuid
  userId        String                  @db.Uuid
  userSessionId String                  @db.Uuid
  reportId      String                  @db.Uuid
  traceId       String                  @unique @db.VarChar(32)
  status        NoteViewerSessionStatus @default(ACTIVE)
  openedAt      DateTime                @default(now())
  lastSeenAt    DateTime                @default(now())
  expiresAt     DateTime
  closedAt      DateTime?
  updatedAt     DateTime                @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userSession UserSession          @relation(fields: [userSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  report      LearnerMonthlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, status, lastSeenAt])
  @@index([reportId, openedAt])
  @@index([userSessionId, status])
  @@index([expiresAt, status])
}

model LearnerStreakState {
  userId            String    @id @db.Uuid
  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  lastQualifiedDate DateTime? @db.Date
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model LearnerStreakDay {
  userId           String          @db.Uuid
  localDate        DateTime        @db.Date
  status           StreakDayStatus @default(ACTIVE)
  timezone         String          @db.VarChar(80)
  focusSeconds     Int             @default(0)
  targetMinutes    Int
  qualifiedAt      DateTime
  protectedAt      DateTime?
  recoveryLedgerId String?         @unique @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recoveryLedger RewardLedgerEntry? @relation(fields: [recoveryLedgerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, localDate])
  @@index([userId, status, localDate])
}

enum NoteViewerSessionStatus {
  ACTIVE
  CLOSED
  EXPIRED
}

model NoteViewerSession {
  id              String                  @id @default(uuid()) @db.Uuid
  userId          String                  @db.Uuid
  userSessionId   String                  @db.Uuid
  contentItemId   String                  @db.Uuid
  traceId         String                  @unique @db.VarChar(32)
  status          NoteViewerSessionStatus @default(ACTIVE)
  pageCount       Int?
  currentPage     Int?
  progressPercent Int                     @default(0)
  scrollOffset    Float?
  openedAt        DateTime                @default(now())
  lastSeenAt      DateTime                @default(now())
  expiresAt       DateTime
  closedAt        DateTime?
  updatedAt       DateTime                @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userSession UserSession @relation(fields: [userSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, status, lastSeenAt])
  @@index([contentItemId, openedAt])
  @@index([userSessionId, status])
  @@index([expiresAt, status])
}

enum NoteRevisionSource {
  ACTION_SHEET
  READER
  MANUAL
}

model LearnerNoteState {
  userId          String    @db.Uuid
  contentItemId   String    @db.Uuid
  completed       Boolean   @default(false)
  favourite       Boolean   @default(false)
  progressPercent Int       @default(0)
  currentPage     Int?
  scrollOffset    Float?
  firstOpenedAt   DateTime?
  lastOpenedAt    DateTime?
  completedAt     DateTime?
  revisionCount   Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contentItem ContentItem         @relation(fields: [contentItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  revisions   NoteRevisionEvent[]

  @@id([userId, contentItemId])
  @@index([userId, favourite, updatedAt])
  @@index([userId, completed, updatedAt])
  @@index([userId, lastOpenedAt])
  @@index([contentItemId])
}

model NoteRevisionEvent {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @db.Uuid
  contentItemId String             @db.Uuid
  source        NoteRevisionSource @default(ACTION_SHEET)
  revisedAt     DateTime           @default(now())
  createdAt     DateTime           @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  noteState LearnerNoteState @relation(fields: [userId, contentItemId], references: [userId, contentItemId], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, revisedAt])
  @@index([contentItemId, revisedAt])
}

enum CourseStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Course {
