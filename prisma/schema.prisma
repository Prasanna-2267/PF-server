model Order {
  id              String            @id @default(uuid()) @db.Uuid
  orderNumber     String            @unique
  userId          String            @db.Uuid
  courseId        String?           @db.Uuid
  currency        String            @default("INR") @db.VarChar(3)
  subtotal        Decimal           @db.Decimal(10, 2)
  discountAmount  Decimal           @default(0.00) @db.Decimal(10, 2)
  totalAmount     Decimal           @db.Decimal(10, 2)
  status          OrderStatus       @default(CREATED)
  refundStatus    RefundStatus      @default(NONE)
  accessStatus    OrderAccessStatus @default(PENDING)
  isComplimentary Boolean           @default(false)
  receiptNumber   String?           @unique
  paymentMethod   String?

  createdAt  DateTime  @default(now())
  paidAt     DateTime?
  refundedAt DateTime?
  updatedAt  DateTime  @updatedAt

  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  course         Course?                @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items          OrderItem[]
  payments       Payment[]
  redemptions    CouponRedemption[]
  entitlements   Entitlement[]
  monthlyReports LearnerMonthlyReport[]

  @@index([userId, status])
  @@index([courseId, status])
  @@index([createdAt])
}

model OrderItem {
  id             String               @id @default(uuid()) @db.Uuid
  orderId        String               @db.Uuid
  contentItemId  String?              @db.Uuid
  packageId      String?              @db.Uuid
  questionBankId String?              @db.Uuid
  resourceType   LearningResourceType
  titleSnapshot  String
  unitPrice      Decimal              @db.Decimal(10, 2)
  quantity       Int                  @default(1)
  totalPrice     Decimal              @db.Decimal(10, 2)

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contentItem  ContentItem?  @relation(fields: [contentItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  package      Package?      @relation(fields: [packageId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  questionBank QuestionBank? @relation(fields: [questionBankId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId])
  @@index([contentItemId])
  @@index([packageId])
  @@index([questionBankId])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @db.Uuid
  provider          String
  providerPaymentId String?       @unique
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR") @db.VarChar(3)
  status            PaymentStatus @default(PENDING)
  paymentMethod     String?
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  refunds PaymentRefund[]

  @@index([orderId])
  @@index([status])
}

model PaymentRefund {
  id               String   @id @default(uuid()) @db.Uuid
  paymentId        String   @db.Uuid
  providerRefundId String   @unique
  amount           Decimal  @db.Decimal(10, 2)
  reason           String
  idempotencyKey   String   @unique
  createdAt        DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([paymentId, createdAt])
}

model Coupon {
  id            String             @id @default(uuid()) @db.Uuid
  code          String             @unique
  discountType  CouponDiscountType
  discountValue Decimal            @db.Decimal(10, 2)
  scope         CouponScope        @default(ALL)
  usageCount    Int                @default(0)
  maxUses       Int?
  enabled       Boolean            @default(true)
  expiresAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  targets     CouponTarget[]
  redemptions CouponRedemption[]

  @@index([code])
  @@index([enabled, expiresAt])
}

model CouponTarget {
  id        String  @id @default(uuid()) @db.Uuid
  couponId  String  @db.Uuid
  packageId String? @db.Uuid
  subjectId String? @db.Uuid

  coupon  Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  package Package? @relation(fields: [packageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([couponId])
  @@index([packageId])
  @@index([subjectId])
}

model CouponRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @db.Uuid
  userId         String   @db.Uuid
  orderId        String   @db.Uuid
  discountAmount Decimal  @db.Decimal(10, 2)
  redeemedAt     DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([couponId, userId])
  @@index([orderId])
}

model Entitlement {
  id               String                @id @default(uuid()) @db.Uuid
  userId           String                @db.Uuid
  resourceType     LearningResourceType
  contentItemId    String?               @db.Uuid
  packageId        String?               @db.Uuid
  questionBankId   String?               @db.Uuid
  subjectId        String?               @db.Uuid
  courseId         String?               @db.Uuid
  resourceTitle    String
  source           EntitlementSource     @default(PURCHASE)
  orderId          String?               @db.Uuid
  accessType       EntitlementAccessType @default(PERMANENT)
  status           EntitlementStatus     @default(ACTIVE)
  grantedAt        DateTime              @default(now())
  purchasedAt      DateTime?
  startsAt         DateTime              @default(now())
  expiresAt        DateTime?
  grantedByAdminId String?               @db.Uuid
  reason           String?
  revokedAt        DateTime?

  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contentItem    ContentItem?           @relation(fields: [contentItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  package        Package?               @relation(fields: [packageId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  questionBank   QuestionBank?          @relation(fields: [questionBankId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subject        Subject?               @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  course         Course?                @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  order          Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  grantedByAdmin User?                  @relation("AdminGrants", fields: [grantedByAdminId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  monthlyReports LearnerMonthlyReport[]

  @@index([userId, status])
  @@index([contentItemId, status])
  @@index([packageId, status])
  @@index([questionBankId, status])
  @@index([orderId])
}

model AuditEvent {
  id              String      @id @default(uuid()) @db.Uuid
  actorId         String      @db.Uuid
  targetStudentId String      @db.Uuid
  action          AuditAction
  reason          String
  before          Json?
  after           Json?
  occurredAt      DateTime    @default(now())

  actor         User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  targetStudent User @relation("AuditTarget", fields: [targetStudentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([targetStudentId, occurredAt])
  @@index([actorId, occurredAt])
}

