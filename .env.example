NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Runtime pool URL and direct migration URL. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate at least 32 cryptographically random bytes. There is no default.
AUTH_JWT_SECRET=
AUTH_ISSUER=parallax-flow-api
AUTH_AUDIENCE=parallax-flow-web
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false
JSON_BODY_LIMIT=1mb
LOG_LEVEL=info

GOOGLE_CLIENT_ID=
AUTH_PASSWORD_REGISTRATION_ENABLED=false
AUTH_STAGED_REGISTRATION_ENABLED=false
AUTH_GOOGLE_REGISTRATION_ENABLED=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# External providers default to disabled. Configure real credentials before
# enabling the corresponding API paths; the server never reports fake success.
STORAGE_DRIVER=disabled
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_SIGNED_URL_TTL_SECONDS=900

EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_BEARER_TOKEN=
EMAIL_PROVIDER=http
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_RECIPIENT_EMAIL=

# Public links used by transactional email. PUBLIC_LOGO_URL may be omitted
# when the web app serves its existing public/logo.png at PUBLIC_APP_URL.
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_LOGO_URL=
SUPPORT_EMAIL=support@parallaxflow.com

# OTP SMS provider. It receives the same idempotent HTTP message envelope as
# the email provider, with a phone destination and registration-otp template.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_BEARER_TOKEN=
# Development/testing only. Production configuration rejects this flag.

PAYMENT_CHECKOUT_URL=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_BEARER_TOKEN=
PAYMENT_PROVIDER_NAME=http
FAKE_PAYMENT_ENABLED=false

# Expo Push Service. EXPO_ACCESS_TOKEN is optional unless enhanced push
# security is enabled for the Expo project.
EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=
NOTIFICATION_MAINTENANCE_INTERVAL_MS=300000
MONTHLY_REPORT_MAINTENANCE_INTERVAL_MS=21600000

# Integration tests are opt-in and reject non-local/non-test database names.
TEST_DATABASE_URL=
RUN_BACKEND_INTEGRATION=0
